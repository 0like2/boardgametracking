# --- 어느 컬렉션을 서비스할지 ---------------------------------------------
# 비워두면 주 컬렉션. `b`면 두 번째 소장 목록(목록 전용 사이트)입니다.
# NEXT_PUBLIC_ 접두사라 빌드 시점에 값이 박히니, 바꾸면 재배포해야 합니다.
# NEXT_PUBLIC_COLLECTION=b
# NEXT_PUBLIC_SITE_TITLE=보드게임 컬렉션

# 대여/모임 신청 알림 — 채널마다 독립적입니다. 비워두면 그 채널만 건너뜁니다.

# 디스코드: 서버 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# 이메일: Gmail SMTP. 계정 비밀번호가 아니라 '앱 비밀번호'를 넣어야 합니다
# (Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 안 적으면 SMTP_USER 로 보냅니다.
NOTIFY_EMAIL_TO=

# Supabase — 신청 내역 저장 및 「신청 현황」 페이지용. 없어도 알림은 정상 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
