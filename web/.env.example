# --- 어느 컬렉션을 서비스할지 ---------------------------------------------
# 비워두면 주 컬렉션. `b`면 두 번째 소장 목록(목록 전용 사이트)입니다.
# NEXT_PUBLIC_ 접두사라 빌드 시점에 값이 박히니, 바꾸면 재배포해야 합니다.
# NEXT_PUBLIC_COLLECTION=b
# NEXT_PUBLIC_SITE_TITLE=보드게임 컬렉션

# 디스코드: 서버 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# Supabase — 신청 내역 저장·로그인·실시간 갱신용. 아지트 예약 배포에는 필수입니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
